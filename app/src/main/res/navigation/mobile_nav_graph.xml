<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_nav_graph"
    app:startDestination="@id/nav_movies">

    <!-- films and series are one list screen with another category -->
    <fragment
        android:id="@+id/nav_movies"
        android:name="ru.lazytv.mobile.CatalogFragment"
        android:label="Фильмы">
        <argument
            android:name="category"
            android:defaultValue="movies"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nav_serials"
        android:name="ru.lazytv.mobile.CatalogFragment"
        android:label="Сериалы">
        <argument
            android:name="category"
            android:defaultValue="serials"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/nav_search"
        android:name="ru.lazytv.mobile.SearchFragment"
        android:label="Поиск" />

    <fragment
        android:id="@+id/nav_favorites"
        android:name="ru.lazytv.mobile.FavoritesFragment"
        android:label="Закладки" />

    <fragment
        android:id="@+id/nav_settings"
        android:name="ru.lazytv.mobile.SettingsFragment"
        android:label="Настройки" />
</navigation>
