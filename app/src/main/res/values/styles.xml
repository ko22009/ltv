<resources>
    <style name="Theme.LazyTV" parent="@style/Theme.Leanback">
        <item name="android:windowBackground">#101216</item>
        <item name="android:windowSplashScreenBackground">#101216</item>
        <!-- the pages start near the top edge: Leanback leaves 167dp there for its title bar, which is not used -->
        <item name="browseRowsMarginTop">28dp</item>
        <!-- on a phone the bars of the system take the colour of the page instead of the grey-green of the system theme -->
        <item name="android:statusBarColor">#101216</item>
        <item name="android:navigationBarColor">#101216</item>
    </style>
    <style name="Theme.LazyTV.Guided" parent="@style/Theme.Leanback.GuidedStep">
        <item name="android:windowBackground">#101216</item>
        <item name="android:statusBarColor">#101216</item>
        <item name="android:navigationBarColor">#101216</item>
    </style>
    <!-- the progress bar of the player: the halo around the focused thumb takes the colour of the focus instead of grey -->
    <style name="PlayerSeekOverlay">
        <item name="android:colorControlHighlight">#664338CA</item>
    </style>
    <!-- the filters lie over the list as a panel: the window is transparent, the catalogue stays behind it, dimmed -->
    <style name="Theme.LazyTV.Filters" parent="@style/Theme.LazyTV">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="Theme.LazyMobile" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#101216</item>
        <item name="android:windowSplashScreenBackground">#101216</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">#4338CA</item>
        <item name="colorSecondary">#6366F1</item>
        <item name="colorSurface">#161920</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">#101216</item>
        <item name="android:navigationBarColor">#161920</item>
    </style>
    <!-- the chip of the phone screens: the plate of the buttons (#1C2029); the chosen one gets the indigo outline, as the active season on the TV -->
    <style name="Widget.LazyMobile.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">#1C2029</item>
        <item name="chipStrokeColor">@color/mobile_chip_stroke</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="chipCornerRadius">6dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- bottom menu of the phone: dark plate, the active section is a plate with the indigo outline (no fill) -->
    <style name="Widget.LazyMobile.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">#161920</item>
        <!-- no elevation overlay: it tinted the menu purple, and the system bar under it (#161920) no longer matched -->
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LazyMobile.BottomNav.Indicator</item>
        <item name="itemIconTint">@color/mobile_nav_item_colors</item>
        <item name="itemTextColor">@color/mobile_nav_item_colors</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.LazyMobile.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.LazyMobile.NavLabel</item>
    </style>
    <style name="Widget.LazyMobile.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
    <style name="TextAppearance.LazyMobile.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>
    <!-- the small grey caption over a block of a phone page -->
    <style name="MobileSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">#94A3B8</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
