<resources>
    <style name="Theme.LazyTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:windowSplashScreenBackground">@color/page_bg</item>
        <!-- on a phone the bars of the system take the colour of the page instead of the grey-green of the system theme -->
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
    </style>
    <!-- the progress bar of the player: the halo around the focused thumb takes the colour of the focus instead of grey -->
    <style name="PlayerSeekOverlay">
        <!-- no system halo: the player draws its own plate under the thumb (PlayerActivity.updateSeekColors) -->
        <item name="android:colorControlHighlight">@android:color/transparent</item>
    </style>
    <!-- the filters lie over the list as a panel: the window is transparent, the catalogue stays behind it, dimmed -->
    <style name="Theme.LazyTV.Filters" parent="@style/Theme.LazyTV">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
    <style name="Theme.LazyMobile" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:windowSplashScreenBackground">@color/page_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/accent_light</item>
        <item name="colorSecondary">@color/accent_light</item>
        <item name="colorSurface">@color/backdrop_plate</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorOnPrimary">@color/page_bg</item>
        <item name="android:statusBarColor">@color/page_bg</item>
        <item name="android:navigationBarColor">@color/backdrop_plate</item>
    </style>
    <!-- the chip of the phone screens: the plate of the buttons (#1C2029); the chosen one gets a light outline (the phone has no teal) -->
    <style name="Widget.LazyMobile.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/plate_fill</item>
        <item name="chipStrokeColor">@color/mobile_chip_stroke</item>
        <item name="chipStrokeWidth">2dp</item>
        <item name="chipCornerRadius">6dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <!-- bottom menu of the phone: dark plate, the active section is a plate with the teal outline (no fill) -->
    <style name="Widget.LazyMobile.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/backdrop_plate</item>
        <!-- no elevation overlay: it tinted the menu purple, and the system bar under it (#161920) no longer matched -->
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.LazyMobile.BottomNav.Indicator</item>
        <!-- lower than the Material default (80dp): less air above and under the icon and the caption -->
        <item name="android:minHeight">56dp</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
        <item name="itemIconTint">@color/mobile_nav_item_colors</item>
        <item name="itemTextColor">@color/mobile_nav_item_colors</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.LazyMobile.NavLabel</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.LazyMobile.NavLabel</item>
    </style>
    <style name="Widget.LazyMobile.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
    <style name="TextAppearance.LazyMobile.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
    </style>
    <!-- the small grey caption over a block of a phone page -->
    <style name="MobileSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
